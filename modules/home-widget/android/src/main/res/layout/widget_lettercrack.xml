<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/lc_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/lettercrack_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/lc_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="LetterCrack"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/lc_streak"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/lettercrack_widget_pill"
      android:paddingStart="10dp"
      android:paddingTop="3dp"
      android:paddingEnd="10dp"
      android:paddingBottom="3dp"
      android:textColor="#1E1B3A"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/lc_cipher"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fontFamily="monospace"
    android:gravity="center_vertical"
    android:letterSpacing="0.15"
    android:maxLines="2"
    android:textColor="#FFE08A"
    android:textSize="22sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/lc_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="2"
    android:textColor="#E4DCFF"
    android:textSize="13sp" />
</LinearLayout>
